[Unit]
Description=VBMFX vs trend report, Mon-Fri 02:14 (uses the previous trading day's close)

[Timer]
OnCalendar=Mon..Fri *-*-* 02:14:00
# no LLM involved and it takes seconds: a run missed while the laptop was off is made at the next boot
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
