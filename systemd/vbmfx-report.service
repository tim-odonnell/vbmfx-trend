[Unit]
Description=VBMFX vs trend report (1m-30y + all history) -> ~/VBMFX-Reports
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/vbmfx-trend --notify
TimeoutStartSec=10min
Nice=10
MemoryMax=300M
